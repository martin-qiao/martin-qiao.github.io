# Server only. Do not prefix these with NEXT_PUBLIC_.
# Copy to .env.local for `npm run dev`. Set the same names in Vercel.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BLOB_READ_WRITE_TOKEN=
ADMIN_PASSWORD=
# Optional. Signs the admin session cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
